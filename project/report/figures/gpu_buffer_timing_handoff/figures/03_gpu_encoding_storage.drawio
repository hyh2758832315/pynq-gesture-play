        </mxCell>
        <mxCell id="bank" value="4,096 B Command bank = 128 × 32 B&#10;每条 8 words；未使用区域补 0&#10;CLEAR 0x01 / TILE 0x02 / BLIT 0x03 / RECT 0x04 / END 0xFF" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#25638d;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;" vertex="1" parent="1">
