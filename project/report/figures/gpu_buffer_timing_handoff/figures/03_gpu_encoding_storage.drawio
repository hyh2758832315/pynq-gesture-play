          <mxGeometry as="geometry" x="100" y="1575" width="930" height="105" />
        </mxCell>
        <mxCell id="video" value="视频：必要时 Palette → 每帧 Atlas → Scene&#10;目标 30 fps；每帧串行提交，与 60 Hz HDMI 扫描分开" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#197b71;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;" vertex="1" parent="1">
