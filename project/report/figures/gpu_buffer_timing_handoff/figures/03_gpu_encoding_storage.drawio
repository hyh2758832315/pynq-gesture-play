          <mxGeometry as="geometry" x="710" y="1290" width="1200" height="60" />
        </mxCell>
        <mxCell id="size_note" value="8 bit token 容量为同分辨率 RGB888 的 1/3；不含 Palette、Atlas、Tilemap 和 BRAM 块取整。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dfe7;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1385" width="1990" height="40" />
        </mxCell>
