set_property PACKAGE_PIN Y18 [get_ports camera_xclk]
set_property PACKAGE_PIN Y17 [get_ports camera_scl]
set_property PACKAGE_PIN Y16 [get_ports camera_sda]
set_property PACKAGE_PIN U18 [get_ports camera_pclk]
set_property PACKAGE_PIN Y19 [get_ports camera_vsync]
set_property PACKAGE_PIN U19 [get_ports camera_href]
set_property PACKAGE_PIN T10 [get_ports {camera_data[0]}]
set_property PACKAGE_PIN V16 [get_ports {camera_data[1]}]
set_property PACKAGE_PIN T11 [get_ports {camera_data[2]}]
set_property PACKAGE_PIN W16 [get_ports {camera_data[3]}]
set_property PACKAGE_PIN Y14 [get_ports {camera_data[4]}]
set_property PACKAGE_PIN V12 [get_ports {camera_data[5]}]
set_property PACKAGE_PIN W14 [get_ports {camera_data[6]}]
set_property PACKAGE_PIN W13 [get_ports {camera_data[7]}]

set_property IOSTANDARD LVCMOS33 [get_ports {camera_xclk camera_scl camera_sda}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_pclk camera_vsync camera_href camera_data[*]}]
set_property DRIVE 4 [get_ports camera_xclk]
set_property SLEW SLOW [get_ports camera_xclk]
set_property PULLUP true [get_ports {camera_scl camera_sda}]
set_property PULLUP false [get_ports {camera_pclk camera_vsync camera_href camera_data[*]}]

set_false_path -from [get_ports {camera_scl camera_sda}]
create_clock -name camera_pclk -period 10.000 [get_ports camera_pclk]
set_input_delay -clock camera_pclk -max 4.000 [get_ports {camera_vsync camera_href camera_data[*]}]
set_input_delay -clock camera_pclk -min 0.000 [get_ports {camera_vsync camera_href camera_data[*]}]
if {[llength [get_clocks -quiet clk_fpga_0]] > 0} {
	set_clock_groups -asynchronous -group [get_clocks camera_pclk] -group [get_clocks clk_fpga_0]
}
set_false_path -to [get_ports {camera_xclk camera_scl camera_sda}]
