set_property PACKAGE_PIN U9 [get_ports IIC_1_scl_io]
set_property PACKAGE_PIN T9 [get_ports IIC_1_sda_io]
set_property IOSTANDARD LVCMOS33 [get_ports {IIC_1_scl_io IIC_1_sda_io}]
set_property PULLUP true [get_ports {IIC_1_scl_io IIC_1_sda_io}]
set_property PACKAGE_PIN U5 [get_ports audio_clk_10MHz]
set_property PACKAGE_PIN R18 [get_ports bclk]
set_property PACKAGE_PIN T17 [get_ports lrclk]
set_property PACKAGE_PIN G18 [get_ports sdata_o]
set_property PACKAGE_PIN F17 [get_ports sdata_i]
set_property PACKAGE_PIN M17 [get_ports {codec_address[0]}]
set_property PACKAGE_PIN M18 [get_ports {codec_address[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {audio_clk_10MHz bclk lrclk sdata_o sdata_i codec_address[*]}]
set_property SLEW SLOW [get_ports {audio_clk_10MHz bclk lrclk sdata_o codec_address[*]}]
set_property DRIVE 8 [get_ports {audio_clk_10MHz bclk lrclk sdata_o codec_address[*]}]
create_generated_clock -name audio_bclk -source [get_pins {c6v_i/ps7_0/inst/PS7_i/FCLKCLK[0]}] -divide_by 32 [get_ports bclk]
create_generated_clock -name audio_lrclk -source [get_pins {c6v_i/ps7_0/inst/PS7_i/FCLKCLK[0]}] -divide_by 2048 [get_ports lrclk]
set_false_path -from [get_ports sdata_i] -to [get_pins -hier -regexp {.*receiver/sdata_sync_reg\[0\]/D}]