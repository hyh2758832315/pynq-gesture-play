          <mxGeometry as="geometry" x="100" y="490" width="600" height="100" />
        </mxCell>
        <mxCell id="rect" value="word0=0x00000004   word1=0x000000F7&#10;word2=0x0014000A   word3=0x00100020   word4–7=0" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#d8dfe7;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="490" width="1340" height="105" />
        </mxCell>
        <mxCell id="index4" value="素材 INDEX4 / 每像素 4 bit&#10;像素 [1,2,3,4] → 字节 [21,43]hex&#10;BLIT 遇到 index 0 跳过写入" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#197b71;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="785" width="550" height="130" />
        </mxCell>
        <mxCell id="token" value="帧缓冲 token / 每像素 8 bit&#10;[7:4] 逻辑调色板组 | [3:0] 色号&#10;0xF7 → 第 15 组，第 7 色" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#bf286e;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="785" width="670" height="130" />
        </mxCell>
        <mxCell id="rgb" value="Palette 查表 → RGB888&#10;逻辑 16 组 × 每组 16 色&#10;物理 active bank 为独立的 0 / 1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#197b71;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="785" width="600" height="130" />
        </mxCell>
        <mxCell id="token_note" value="逻辑调色板组、物理调色板 bank、命令 bank、帧缓冲 bank 是四种不同索引，不能合并画成一组。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dfe7;fontColor=#172b3a;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;fillColor=none;strokeColor=none;" vertex="1" parent="1">
